# Banco de dados
DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/gerenciar_gastos

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Servidor
PORT=3001
NODE_ENV=development

# CORS — URL do frontend
CORS_ORIGIN=http://localhost:3000

# Pluggy (Open Finance)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai
# A API Key e gerada em runtime via POST /auth (validade ~2h).
# Preencher abaixo apenas para testes manuais pontuais.
PLUGGY_API_KEY=

# Connect token de teste manual (efemero, ~30min).
# Em producao e gerado on-demand via POST /connect_token.
PLUGGY_CONNECT_TOKEN=

# Segredo do webhook (vai na URL cadastrada no dashboard da Pluggy)
PLUGGY_WEBHOOK_SECRET=
